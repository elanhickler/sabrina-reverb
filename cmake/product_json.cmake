# se_load_product(<slug>)
#
# Reads products/<slug>/product.json (the single source for identity, params
# and layout), checks it against products/<slug>/params.lock, and writes
# ${CMAKE_BINARY_DIR}/generated/<slug>/product_generated.h.
# Sets in the caller: SE_PRODUCT_NAME, SE_PRODUCT_VERSION, SE_PRODUCT_CLAP_ID,
# SE_PRODUCT_PATCH_EXT, SE_PRODUCT_FORMATS,
# SE_PRODUCT_GENERATED_DIR.

function(_se_json_get out json)
    string(JSON _v ERROR_VARIABLE _err GET "${json}" ${ARGN})
    if (_err)
        set(_v "")
    endif()
    set(${out} "${_v}" PARENT_SCOPE)
endfunction()

function(_se_cstr out s)
    string(REPLACE "\\" "\\\\" s "${s}")
    string(REPLACE "\"" "\\\"" s "${s}")
    set(${out} "\"${s}\"" PARENT_SCOPE)
endfunction()

function(se_load_product slug)
    set(_pdir "${CMAKE_SOURCE_DIR}/products/${slug}")
    set(_jf "${_pdir}/product.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_jf}" "${_pdir}/params.lock")
    file(READ "${_jf}" _j)

    foreach (_k slug name version clapId vendor url patchVersion patchExtension vendorFolder
                sandboxModule description)
        _se_json_get(_v "${_j}" ${_k})
        if ("${_v}" STREQUAL "")
            message(FATAL_ERROR "products/${slug}/product.json: missing \"${_k}\"")
        endif()
        set(_p_${_k} "${_v}")
    endforeach()
    if (NOT "${_p_slug}" STREQUAL "${slug}")
        message(FATAL_ERROR "products/${slug}/product.json: slug \"${_p_slug}\" must match folder")
    endif()

    string(JSON _nf LENGTH "${_j}" formats)
    set(_formats "")
    math(EXPR _last "${_nf} - 1")
    foreach (i RANGE ${_last})
        string(JSON _f GET "${_j}" formats ${i})
        list(APPEND _formats "${_f}")
    endforeach()
    list(JOIN _formats " " _formats_s)

    string(JSON _ncf LENGTH "${_j}" clapFeatures)
    math(EXPR _last "${_ncf} - 1")
    set(_cfeat "")
    foreach (i RANGE ${_last})
        string(JSON _f GET "${_j}" clapFeatures ${i})
        _se_cstr(_fq "${_f}")
        string(APPEND _cfeat "${_fq}, ")
    endforeach()
    _se_json_get(_au_type "${_j}" au type)
    _se_json_get(_au_subt "${_j}" au subtype)
    string(LENGTH "${_au_type}" _l1)
    string(LENGTH "${_au_subt}" _l2)
    if (NOT _l1 EQUAL 4 OR NOT _l2 EQUAL 4)
        message(FATAL_ERROR "products/${slug}/product.json: au.type and au.subtype must be 4 characters")
    endif()

    # --- params ---
    string(JSON _np LENGTH "${_j}" params)
    if (_np EQUAL 0)
        message(FATAL_ERROR "products/${slug}/product.json: no params")
    endif()
    math(EXPR _last "${_np} - 1")
    set(_rows "")
    set(_choices "")
    set(_idx "")
    set(_ids "")
    set(_keys "")
    set(_seen_ids "")
    set(_lockcheck "")
    foreach (i RANGE ${_last})
        foreach (_f key id name group type min max default)
            _se_json_get(_${_f} "${_j}" params ${i} ${_f})
            if ("${_${_f}}" STREQUAL "")
                message(FATAL_ERROR "products/${slug}/product.json: params[${i}] missing \"${_f}\"")
            endif()
        endforeach()
        _se_json_get(_unit "${_j}" params ${i} unit)
        if (NOT _key MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
            message(FATAL_ERROR "param key \"${_key}\" must be a C identifier")
        endif()
        if ("${_id}" IN_LIST _seen_ids)
            message(FATAL_ERROR "products/${slug}/product.json: duplicate param id ${_id}")
        endif()
        list(APPEND _seen_ids "${_id}")
        list(APPEND _keys "${_key}")
        list(APPEND _lockcheck "${_id} ${_key} ${_type}")

        if (_type STREQUAL "percent")
            set(_t "Percent")
        elseif (_type STREQUAL "unit")
            set(_t "Unit")
        elseif (_type STREQUAL "int")
            set(_t "Integer")
        elseif (_type STREQUAL "choice")
            set(_t "Choice")
        else()
            message(FATAL_ERROR "param ${_key}: unknown type \"${_type}\" (percent|unit|int|choice)")
        endif()

        set(_chp "nullptr")
        set(_chn 0)
        if (_type STREQUAL "choice")
            string(JSON _chn LENGTH "${_j}" params ${i} choices)
            math(EXPR _cl "${_chn} - 1")
            set(_cs "")
            foreach (c RANGE ${_cl})
                string(JSON _cv GET "${_j}" params ${i} choices ${c})
                _se_cstr(_cq "${_cv}")
                string(APPEND _cs "{${c}, ${_cq}}, ")
            endforeach()
            string(APPEND _choices "inline constexpr ChoiceDesc choices_${_key}[] = {${_cs}};\n")
            set(_chp "choices_${_key}")
        endif()

        # float literal keeps the exact value the old hand table used (0.43f)
        set(_deff "${_default}")
        if (NOT _deff MATCHES "[.eE]")
            set(_deff "${_deff}.0")
        endif()
        _se_cstr(_nq "${_name}")
        _se_cstr(_gq "${_group}")
        _se_cstr(_uq "${_unit}")
        _se_cstr(_kq "${_key}")
        string(APPEND _rows
            "    {${_id}u, ${_kq}, ${_nq}, ${_gq}, ParamType::${_t}, ${_min}, ${_max}, ${_default}, ${_deff}f, ${_uq}, ${_chp}, ${_chn}},\n")
        string(APPEND _idx "    ${_key} = ${i},\n")
        string(APPEND _ids "    ${_key} = ${_id}u,\n")
    endforeach()

    # --- params.lock: shipped ids never change or disappear ---
    set(_lf "${_pdir}/params.lock")
    if (NOT EXISTS "${_lf}")
        message(FATAL_ERROR "products/${slug}/params.lock missing. Create it with one \"id key type\" line per param.")
    endif()
    file(STRINGS "${_lf}" _locklines REGEX "^[0-9]")
    foreach (_l ${_locklines})
        string(REGEX REPLACE "[ \t]+" " " _l "${_l}")
        string(STRIP "${_l}" _l)
        if (NOT "${_l}" IN_LIST _lockcheck)
            message(FATAL_ERROR "products/${slug}: params.lock entry \"${_l}\" no longer matches product.json. Shipped param ids must never change.")
        endif()
    endforeach()
    foreach (_l ${_lockcheck})
        if (NOT "${_l}" IN_LIST _locklines)
            message(FATAL_ERROR "products/${slug}: param \"${_l}\" is not in params.lock. Add the line once the id is final.")
        endif()
    endforeach()

    # --- layout order (keys) ---
    string(JSON _nl LENGTH "${_j}" layout order)
    math(EXPR _last "${_nl} - 1")
    set(_order "")
    foreach (i RANGE ${_last})
        string(JSON _lk GET "${_j}" layout order ${i})
        if (NOT "${_lk}" IN_LIST _keys)
            message(FATAL_ERROR "products/${slug}: layout.order \"${_lk}\" is not a param key")
        endif()
        string(APPEND _order "param_index::${_lk}, ")
    endforeach()

    set(_p_au_type "${_au_type}")
    set(_p_au_subt "${_au_subt}")
    foreach (_k name version clapId vendor url patchExtension vendorFolder sandboxModule slug
                description au_type au_subt)
        _se_cstr(_q_${_k} "${_p_${_k}}")
    endforeach()

    set(_gdir "${CMAKE_BINARY_DIR}/generated/${slug}")
    set(_out "// GENERATED from products/${slug}/product.json by cmake/product_json.cmake. Do not edit.\n#pragma once\n\n#include \"product/param-desc.h\"\n\nnamespace se::product\n{\n")
    string(APPEND _out "inline constexpr const char *slug = ${_q_slug};\n")
    string(APPEND _out "inline constexpr const char *name = ${_q_name};\n")
    string(APPEND _out "inline constexpr const char *version = ${_q_version};\n")
    string(APPEND _out "inline constexpr const char *clapId = ${_q_clapId};\n")
    string(APPEND _out "inline constexpr const char *vendor = ${_q_vendor};\n")
    string(APPEND _out "inline constexpr const char *url = ${_q_url};\n")
    string(APPEND _out "inline constexpr uint32_t patchVersion = ${_p_patchVersion};\n")
    string(APPEND _out "inline constexpr const char *patchExtension = ${_q_patchExtension};\n")
    string(APPEND _out "inline constexpr const char *vendorFolder = ${_q_vendorFolder};\n")
    string(APPEND _out "inline constexpr const char *sandboxModule = ${_q_sandboxModule};\n")
    string(APPEND _out "inline constexpr const char *description = ${_q_description};\n")
    string(APPEND _out "inline constexpr const char *auType = ${_q_au_type};\n")
    string(APPEND _out "inline constexpr const char *auSubtype = ${_q_au_subt};\n")
    string(APPEND _out "inline constexpr const char *clapFeatures[] = {${_cfeat}nullptr};\n\n")
    string(APPEND _out "${_choices}\n")
    string(APPEND _out "inline constexpr ParamDesc params[] = {\n${_rows}};\n")
    string(APPEND _out "inline constexpr size_t numParams = sizeof(params) / sizeof(params[0]);\n\n")
    string(APPEND _out "namespace param_index\n{\nenum : size_t\n{\n${_idx}};\n}\n")
    string(APPEND _out "namespace param_id\n{\nenum : uint32_t\n{\n${_ids}};\n}\n\n")
    string(APPEND _out "inline constexpr size_t layoutOrder[] = {${_order}};\n")
    string(APPEND _out "inline constexpr size_t numLayout = sizeof(layoutOrder) / sizeof(layoutOrder[0]);\n")
    string(APPEND _out "} // namespace se::product\n")
    file(CONFIGURE OUTPUT "${_gdir}/product_generated.h" CONTENT "${_out}" @ONLY)

    set(SE_PRODUCT_NAME "${_p_name}" PARENT_SCOPE)
    set(SE_PRODUCT_VERSION "${_p_version}" PARENT_SCOPE)
    set(SE_PRODUCT_CLAP_ID "${_p_clapId}" PARENT_SCOPE)
    set(SE_PRODUCT_PATCH_EXT "${_p_patchExtension}" PARENT_SCOPE)
    set(SE_PRODUCT_FORMATS "${_formats_s}" PARENT_SCOPE)
    set(SE_PRODUCT_GENERATED_DIR "${_gdir}" PARENT_SCOPE)
endfunction()
